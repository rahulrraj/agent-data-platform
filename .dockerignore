# Keep build contexts small and host-specific files out of images.
# This file governs every repo-root build (repo-root Dockerfile,
# Dockerfile.lambda, and src/ui/Dockerfile, all built with the repo root
# as context). src/ui/.dockerignore covers builds run with src/ui/ as
# the context instead.
node_modules/
dist/
.git/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.env
*.tfstate*
.terraform/
*.tfplan
