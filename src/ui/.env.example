# Build-time configuration for the Agent UI. Copy to .env for local
# dev, or pass the variables to `npm run build`. All values below are
# obviously fake placeholders — no real tenant or client id.
# See README.md "Authentication (ADR 0008)".

# API origin for a deployed build (relative /api/* when unset).
# VITE_API_URL=https://api.example.com

# OIDC issuer base URL (required for a production build).
VITE_OIDC_ISSUER=https://example.okta.com

# OIDC client id registered for this UI (required for a production build).
VITE_OIDC_CLIENT_ID=your-client-id

# Expected `aud` claim on the id_token (optional; defaults to the client id).
# VITE_OIDC_AUDIENCE=

# Dev ONLY: bypass the login gate. Honored only in dev builds;
# production builds ignore it.
# VITE_AUTH_DISABLED=true
